# Optional. Leave unset to use the bundled Orange County fixture dataset.
# Values: fixture | ocpa-live
DATA_SOURCE=fixture

# Optional Census Bureau API key for live ACS income (https://api.census.gov/data/key_signup.html).
# The pilot fixtures use Census Reporter and do not need this key.
CENSUS_API_KEY=

# Optional MapTiler Cloud key for a navigation-style Streets basemap and a hybrid satellite
# (imagery, roads, and labels) closer to Google Maps. The map works without it:
# Streets falls back to CARTO Voyager and Satellite hybrid uses Esri World Imagery plus
# Esri transportation and place-label tiles. This key is exposed to the browser
# (NEXT_PUBLIC). Restrict it by URL in MapTiler Cloud. https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=

# Override public GIS endpoints only if a feed URL changes.
OCPA_PARCELS_URL=https://vgispublic.ocpafl.org/server/rest/services/Webmap/PARCEL/MapServer/4/query
FDOT_AADT_URL=https://gis.fdot.gov/arcgis/rest/services/RCI_Layers/FeatureServer/0/query
OC_FLU_URL=https://ocgis4.ocfl.net/arcgis/rest/services/AGOL_Open_Data/MapServer/21/query
ORL_FLU_URL=https://ocgis4.ocfl.net/arcgis/rest/services/AGOL_Open_Data/MapServer/83/query
HUD_OZ_URL=https://services.arcgis.com/VTyQ9soqVukalItT/ArcGIS/rest/services/Opportunity_Zones/FeatureServer/13/query
