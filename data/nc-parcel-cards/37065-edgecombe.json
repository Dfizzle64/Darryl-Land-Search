      "primaryOwnerField": "owner",
      "rule": "Uppercase and trim the owner name(s), then flag as entity if it matches the regex (apply to every owner field; any hit = entity). Note: TRUSTEE does not match the TRUST word rule, and a surname such as CHURCH at the start of the name is a known false positive.",
      "regex": "\\b(LLC|L\\.L\\.C\\.?|INC\\.?|CORP(ORATION)?|LP|L\\.P\\.|LLP|LTD|TRUST|CHURCH|COMPANY|PARTNERSHIP|HOLDINGS|PROPERTIES)\\b|^(CITY|COUNTY|STATE|TOWN) OF\\b",
      "tokens": [
        "LLC",
        "INC",
        "LP",
        "LLP",
        "LTD",
        "TRUST",
        "CHURCH",
        "COMPANY",
        "PARTNERSHIP",
        "HOLDINGS",
        "PROPERTIES",
        "CORP/CORPORATION"
      ],
      "prefixes": [
        "CITY OF",
        "COUNTY OF",
        "STATE OF",
        "TOWN OF"
      ],
      "sqlApproxWhere": "(UPPER(owner) LIKE '% LLC%' OR UPPER(owner) LIKE '% INC%' OR UPPER(owner) LIKE '% LP%' OR UPPER(owner) LIKE '% LLP%' OR UPPER(owner) LIKE '% LTD%' OR UPPER(owner) LIKE '% TRUST%' OR UPPER(owner) LIKE '% CHURCH%' OR UPPER(owner) LIKE '% COMPANY%' OR UPPER(owner) LIKE '% PARTNERSHIP%' OR UPPER(owner) LIKE '% HOLDINGS%' OR UPPER(owner) LIKE '% PROPERTIES%' OR UPPER(owner) LIKE '% CORP%' OR UPPER(owner) LIKE '%,LLC%' OR UPPER(owner) LIKE '%,INC%' OR UPPER(owner) LIKE 'CITY OF %' OR UPPER(owner) LIKE 'COUNTY OF %' OR UPPER(owner) LIKE 'STATE OF %' OR UPPER(owner) LIKE 'TOWN OF %')",
      "liveEntityCountAll": 6623,
      "liveEntityCount5to150ac": 1251,
      "countNote": "The live count uses the SQL approximation (LIKE '% TOKEN%' on the primary owner field, which also catches TRUSTEE/INCOME-style prefixes) together with the acreage filter above."
