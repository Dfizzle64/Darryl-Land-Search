{
  "name": "orange-county-mf-site-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Pilot GIS app for multifamily site selection in Orange County, Florida.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "test": "vitest run",
    "seed": "python3 scripts/seed_fixtures.py && python3 scripts/join_flu.py && python3 scripts/seed_zoning.py",
    "seed:flu": "python3 scripts/join_flu.py",
    "seed:zoning": "python3 scripts/seed_zoning.py"
  },
  "dependencies": {
    "maplibre-gl": "^5.7.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
